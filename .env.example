# Copy to .env.local and fill in.

# --- Contact form (src/app/actions.ts) ---
# The Gmail account that sends the messages and receives them.
GMAIL_USER=you@gmail.com
# A Google app password: Google Account → Security → 2-Step Verification → App passwords.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Dashboard (Sanity, free plan). Leave the project id empty to use src/data/site.ts instead. ---
# From sanity.io/manage → your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only for scripts/seed-sanity.mts: sanity.io/manage → API → Tokens → Add token (Editor). Never commit it.
SANITY_WRITE_TOKEN=
# Any long random string; the same value goes in the Sanity webhook (see src/app/api/revalidate/route.ts).
SANITY_REVALIDATE_SECRET=
